 # TimeCut 环境变量配置
 # 复制为 .env 后修改

 # 摄像头 RTSP 地址
 CAMERA_RTSP_URL=rtsp://user:password@camera_ip:554/stream
 CAMERA_NAME=客厅摄像头

 # 循环录像保留天数（默认 7 天）
 RECORDING_RETENTION_DAYS=7

 # 录像分段时长（分钟）
 RECORDING_SEGMENT_MINUTES=60

 # 录制间隔（分钟，0=连续录制；大于0时每录一段「分段时长」后间隔 N 分钟再录）
 RECORDING_INTERVAL_MINUTES=0

 # 录制时间段（24小时制，支持跨午夜如 22:00-06:00）
 RECORDING_START_TIME=00:00
 RECORDING_END_TIME=23:59

 # 精华视频时长（分钟，默认 5 分钟）
 HIGHLIGHT_DURATION_MINUTES=5

 # 单个运动片段在精华视频中最多占用的秒数（超长片段自动截取运动最密集的一段）
 HIGHLIGHT_MAX_SEGMENT_SECONDS=20

 # 同一小时内精华最多保留的片段数（让精华分散到全天）
 HIGHLIGHT_MAX_SEGMENTS_PER_HOUR=2

 # 只保留有人画面（YOLO 人物检测；当天无人时自动回退运动模式）
 YOLO_ENABLED=true
 # YOLO 模型路径（随镜像内置，一般无需修改）
 YOLO_MODEL_PATH=/app/models/yolo11n.onnx
 # 人物检测置信度阈值（0.05-0.95）
 YOLO_CONFIDENCE=0.4

 # 启用精华检测
 HIGHLIGHT_ENABLED=true

 # 每日精华检测时间（24 小时制）
 HIGHLIGHT_SCHEDULE_TIME=03:00

 # 运动检测灵敏度（1-100，越高越灵敏）
DETECTION_SENSITIVITY=30

# 启用大模型日记（需同时配置大模型 API）
DIARY_ENABLED=false

# 录制开关（false 时服务重启也不会自动录制）
RECORDING_ENABLED=true

 # Web 服务端口
 WEB_PORT=8090

 # 数据存储目录（Docker 部署为 /data，勿改）
 DATA_DIR=/data

 # go2rtc API 地址（Docker 部署为 http://go2rtc:1984）
 GO2RTC_URL=http://go2rtc:1984

 # TZ 时区
 TZ=Asia/Shanghai
